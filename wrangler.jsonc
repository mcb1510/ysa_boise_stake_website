{
  "name": "ysa-boise-stake-website",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ysa-stake-calendar",
      "database_id": "8f88cdd4-e3ff-4d37-b88a-6442650d6af2",
      "migrations_dir": "migrations"
    }
  ]
}
