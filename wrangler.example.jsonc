{
  "name": "ysa-boise-stake-website",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-18",
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "ysa-stake-calendar", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "migrations"}]
}
